# Canonical domain: https://gusi.nyc (single-hop 301, preserves path + query).
# Note: https://www.gusi.nyc only works if DNS + the SSL certificate cover the
# www hostname; otherwise browsers fail before reaching Apache (DNS/SSL action
# required at the hosting level, not in this file).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www (any scheme) -> https://gusi.nyc, one hop
  RewriteCond %{HTTP_HOST} ^www\.gusi\.nyc$ [NC]
  RewriteRule ^(.*)$ https://gusi.nyc/$1 [R=301,L]

  # http -> https on the bare domain
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://gusi.nyc/$1 [R=301,L]
</IfModule>

# Custom 404 page (prerendered, branded, noindex)
ErrorDocument 404 /404.html

# Don't let mod_dir 301-redirect slashless directory URLs; we serve the
# prerendered index.html at the exact URL instead (200, no redirect).
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
Options -Indexes

# Routing for the prerendered site:
# - Real files are served directly.
# - Prerendered routes (dist/<route>/index.html) are served at both the
#   slashless and trailing-slash URL without any redirect.
# - Unknown /blog/... slugs return a real HTTP 404 (no soft-404), because
#   every valid article exists as a physical directory after the build.
# - Remaining app routes fall back to the SPA index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve real files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Serve <dir>/index.html for prerendered routes (slashless or slashed)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]

  # 3. "Inside GUSI" gallery lives on the homepage; /space is not an app
  #    route, so send visitors to the homepage space section (single hop).
  RewriteRule ^space/?$ https://gusi.nyc/#space [R=301,NE,L]

  # 4. Unknown blog slugs must return a real 404
  RewriteRule ^blog/ - [R=404,L]

  # 5. SPA fallback for any remaining client-side routes
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed asset files; short-cache html so deploys take effect.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|webp|jpg|jpeg|png|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
