# SPA fallback: send any request that is not a real file to index.html so
# client-side routes (e.g. /press, /blog, /blog/<slug>) work on direct hits.
# Note: directories are intentionally NOT exempted — asset folders like
# /blog/ or /gallery/ contain no index.html, so a bare directory URL must
# fall through to the app instead of returning a 403 directory listing.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>

# Long-cache hashed asset files; short-cache html so deploys take effect.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|webp|jpg|jpeg|png|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
