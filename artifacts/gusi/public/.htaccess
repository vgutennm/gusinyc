# Custom 404 page (prerendered, branded, noindex)
ErrorDocument 404 /404.html

# Routing for the prerendered site:
# - Real files are served directly.
# - Prerendered routes (dist/<route>/index.html) are served without a
#   trailing-slash redirect so /blog/<slug> answers 200 at the exact URL.
# - Unknown /blog/... slugs return a real HTTP 404 (no soft-404), because
#   every valid article exists as a physical directory after the build.
# - Remaining app routes fall back to the SPA index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve real files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Serve prerendered directory indexes at the slashless URL (no 301)
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # 3. Existing directories (trailing-slash URLs) — let mod_dir serve index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Unknown blog slugs must return a real 404
  RewriteRule ^blog/ - [R=404,L]

  # 5. SPA fallback for any remaining client-side routes
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed asset files; short-cache html so deploys take effect.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|webp|jpg|jpeg|png|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
